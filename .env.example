# Proposal Agent configuration.
# Copy this file to `.env` (`cp .env.example .env`). The defaults below start a working app in FAKE mode:
# no API keys, PubMed served from the test fixtures. `.env` is git-ignored; never commit real keys.

# --- Django -------------------------------------------------------------------------------------------------------
# A long random string. Change it for any real deployment
# (python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=change-me-this-is-only-for-the-local-demo
# 1 shows error pages with details (development only). Keep 0 anywhere real.
DJANGO_DEBUG=0
# Host names the app answers to, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins allowed to POST forms when behind a proxy or another domain, e.g. https://proposals.example.org
CSRF_TRUSTED_ORIGINS=
# 1 when a reverse proxy terminates HTTPS and sends X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=0
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------------------------------------------
# docker compose builds a MySQL 8.4 database from the MYSQL_* values; DATABASE_URL must match them.
# Without DATABASE_URL the app uses SQLite in var/db.sqlite3 (handy for local development).
DATABASE_URL=mysql://proposal:proposal-demo-password@db:3306/proposal_agent
MYSQL_DATABASE=proposal_agent
MYSQL_USER=proposal
MYSQL_PASSWORD=proposal-demo-password
MYSQL_ROOT_PASSWORD=root-demo-password
# Host port for the web app in docker compose (http://localhost:8000).
WEB_PORT=8000

# --- Language model -----------------------------------------------------------------------------------------------
# fake = deterministic canned outputs (offline demo, tests). openai (the code default) or gemini need LLM_API_KEY.
LLM_PROVIDER=fake
LLM_API_KEY=
# Optional overrides: any OpenAI-compatible endpoint and model names.
LLM_BASE_URL=
LLM_MODEL=
LLM_MODEL_STRONG=
# Leave empty for reasoning models (temperature is then not sent).
LLM_TEMPERATURE=
# reasoning_effort for the small and the strong model; an empty value means "do not send it".
LLM_REASONING_EFFORT=none
LLM_REASONING_EFFORT_STRONG=low
LLM_TIMEOUT=90
LLM_MAX_PARALLEL=4
# US dollars per million tokens; when both are set, the app shows the cost of each proposal.
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# --- PubMed (NCBI E-utilities) ------------------------------------------------------------------------------------
# NCBI asks every tool to identify itself. With an API key the rate limit rises from 3 to 9 requests per second.
NCBI_TOOL=proposal_agent
NCBI_EMAIL=
NCBI_API_KEY=
# 1 = serve PubMed from tests/fixtures (offline demo). Set 0 for real searches.
PUBMED_OFFLINE=1

# --- App ----------------------------------------------------------------------------------------------------------
# Bearer tokens for the JSON API, comma-separated. Empty = API closed (403) unless DJANGO_DEBUG=1.
API_TOKENS=
# Space-separated origins allowed to embed the web pages in an iframe, e.g. 'self' https://academy.example.org
FRAME_ANCESTORS='self'
# When set, the web UI asks for this code once per browser session.
WEB_ACCESS_CODE=
# How many similar studies the background keeps (5–10) and how many records are screened by the model.
BACKGROUND_MAX_PAPERS=8
BACKGROUND_SCREEN_TOP=40
